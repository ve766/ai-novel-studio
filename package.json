{
  "name": "ai-novel-studio",
  "version": "1.0.0",
  "private": true,
  "description": "本地优先的 AI 小说创作平台桌面应用",
  "main": "electron/main.cjs",
  "author": "vitamins",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win portable nsis --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "verify:package": "node scripts/verify-package.cjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "lucide-react": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "com.vitamins.ainovelstudio",
    "productName": "AI小说创作平台",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "toolsets": {
      "wine": "1.0.1"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*",
      "!tests/**/*",
      "!src/**/*",
      "!release/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "AI小说创作平台-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "AI小说创作平台-${version}-${arch}-便携版.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "artifactName": "AI小说创作平台-${version}-${arch}-安装版.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI小说创作平台"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office;TextEditor;"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
